{
    "name": "sslws/proxy-client",
    "description": "PHP client for the SSLWS proxy API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sslws",
        "proxy",
        "webhook",
        "dcv"
    ],
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "SslwsProxy\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SslwsProxy\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
